# Copy to .env.local for local dev. For EAS builds set the same names with `eas env:create` (never commit real values).
# Same project as the web app (web uses VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public web origin (invite QR, Paystack return page, share links). Same value the web app serves from.
EXPO_PUBLIC_WEB_BASE_URL=https://classes.promptiq.com.ng
# 'implicit' keeps "open the email link on any device" working (as on web). 'pkce' is stricter; decided by spike S3 (ADR-003).
EXPO_PUBLIC_AUTH_FLOW=implicit

# Build-time only (read by app.config.ts)
APP_VARIANT=development
APP_BUNDLE_ID=ng.com.promptiq.iqacademy
WEB_HOST=classes.promptiq.com.ng
EAS_PROJECT_ID=
