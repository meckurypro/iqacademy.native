{
  "_doc": "Single source of truth for routes. web = the web route path; file = expo-router file under src/app; module = owner (port/PLAN.md); page = web page file; guard = roles allowed (omit = any signed-in role; the database is the real gatekeeper). Run `node scripts/routes.mjs` to create missing stubs and `node scripts/routes.mjs --check` to compare with the web App.tsx.",
  "routes": [
    {
      "web": "/",
      "file": "(app)/index.tsx",
      "module": "M5",
      "page": "RoleHome (StudentHome/InstructorHome/AdminHome/CoordinatorHome/DirectorHome/StaffHome)",
      "stub": false
    },
    {
      "web": "/welcome",
      "file": "(public)/welcome.tsx",
      "module": "M6",
      "page": "src/pages/Landing.tsx",
      "note": "web serves Landing at '/' when signed out; native uses /welcome because '/' is the signed-in home"
    },
    {
      "web": "/login",
      "file": "(public)/login.tsx",
      "module": "M6",
      "page": "src/pages/Login.tsx"
    },
    {
      "web": "/reset-password",
      "file": "reset-password.tsx",
      "module": "M6",
      "page": "src/pages/ResetPassword.tsx",
      "note": "reachable signed in or out (recovery link signs the user in)"
    },
    {
      "web": "/verify-email",
      "file": "verify-email.tsx",
      "module": "M6",
      "page": "src/pages/VerifyEmail.tsx",
      "note": "reachable signed in or out"
    },
    {
      "web": "(auth callback)",
      "file": "auth/callback.tsx",
      "module": "M6",
      "page": "(native only)",
      "note": "email confirmation / recovery deep link: iqacademy://auth/callback"
    },
    {
      "web": "/history",
